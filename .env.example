# PostgreSQL connection string used by the app at runtime.
# If your host pools connections (e.g. Neon's "pooled" string, PgBouncer),
# put the pooled URL here.
DATABASE_URL="postgresql://revally:revally_dev_pw@localhost:5432/revally_wheel"

# Direct (non-pooled) connection string, used only by `prisma migrate` to
# acquire its migration lock — pooled connections can't do this reliably.
# If you're not using a pooler (e.g. local Postgres), this can be the same
# value as DATABASE_URL.
DIRECT_URL="postgresql://revally:revally_dev_pw@localhost:5432/revally_wheel"

# Secret used to sign admin session JWTs — generate a long random string for production
# e.g. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app, used to build absolute links (e.g. in emails)
APP_URL="http://localhost:3000"
